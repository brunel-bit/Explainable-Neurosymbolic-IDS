          "weight": 1.6,
          "tag": "services"
        },
        {
          "operator": "<",
          "threshold": 0.5,
          "state": "low",
          "verb": "observe",
          "object": "destination_service_diversity",
          "weight": 1.0,
          "tag": "services"
        }
      ]
    },
    "short_window_service_diversity": {
      "conditions": [
        {
          "operator": ">=",
          "threshold": 0.5,
          "state": "high",
          "verb": "increase",
