{
  "version": "1.1",
  "description": "Semantic actions generated from NSL-KDD semantic concepts.",
  "actions": {
    "same_destination_connection_count": {
      "conditions": [
        {
          "operator": ">=",
          "threshold": 100,
          "state": "high",
          "verb": "increase",
          "object": "destination_connection_activity",
          "weight": 2.0,
          "tag": "traffic"
        },
        {
          "operator": "<",
          "threshold": 100,
          "state": "normal",
          "verb": "observe",
          "object": "destination_connection_activity",
          "weight": 1.0,
          "tag": "traffic"
        }
      ]
    },
    "same_service_connection_count": {
      "conditions": [
        {
          "operator": ">=",
          "threshold": 20,
          "state": "high",
          "verb": "increase",
          "object": "service_connection_activity",
          "weight": 1.8,
          "tag": "traffic"
        },
        {
          "operator": "<",
          "threshold": 20,
          "state": "normal",
          "verb": "observe",
          "object": "service_connection_activity",
          "weight": 1.0,
          "tag": "traffic"
        }
      ]
    },
    "destination_rejection_error_rate": {
      "conditions": [
        {
          "operator": ">=",
          "threshold": 0.5,
          "state": "high",
          "verb": "increase",
          "object": "connection_rejections",
          "weight": 2.2,
          "tag": "network"
        },
        {
          "operator": "<",
          "threshold": 0.5,
          "state": "low",
          "verb": "observe",
          "object": "connection_rejections",
          "weight": 1.0,
          "tag": "network"
        }
      ]
    },
    "destination_service_diversity": {
