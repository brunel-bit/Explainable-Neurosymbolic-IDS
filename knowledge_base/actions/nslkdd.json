      "conditions": [
        {
          "operator": "==",
          "threshold": 1,
          "state": "authenticated",
          "verb": "observe",
          "object": "successful_authentication",
          "weight": 1.5,
          "tag": "authentication"
        },
        {
          "operator": "==",
          "threshold": 0,
          "state": "not_authenticated",
          "verb": "observe",
          "object": "authentication_absence",
          "weight": 1.5,
          "tag": "authentication"
        }
      ]
    },
    "outbound_transfer_volume": {
      "conditions": [
        {
          "operator": ">",
          "threshold": 0,
          "state": "present",
          "verb": "transfer",
          "object": "outbound_data",
          "weight": 1.2,
          "tag": "data"
        },
        {
          "operator": "==",
          "threshold": 0,
          "state": "absent",
          "verb": "observe",
          "object": "no_outbound_data",
          "weight": 1.0,
          "tag": "data"
        }
      ]
    },
    "inbound_transfer_volume": {
      "conditions": [
        {
          "operator": ">",
          "threshold": 0,
          "state": "present",
          "verb": "transfer",
          "object": "inbound_data",
          "weight": 1.2,
          "tag": "data"
        },
        {
          "operator": "==",
          "threshold": 0,
          "state": "absent",
          "verb": "observe",
          "object": "no_inbound_data",
          "weight": 1.0,
          "tag": "data"
        }
      ]
    },
    "source_port_reuse_rate": {
      "conditions": [
        {
          "operator": ">=",
          "threshold": 0.5,
          "state": "high",
          "verb": "increase",
          "object": "source_port_reuse",
          "weight": 1.3,
          "tag": "ports"
        },
        {
          "operator": "<",
          "threshold": 0.5,
          "state": "low",
          "verb": "observe",
          "object": "source_port_reuse",
          "weight": 1.0,
          "tag": "ports"
